# Local dev (no Postgres/Docker required): a file:./... URL (libSQL/SQLite)
# makes the config below use @payloadcms/db-sqlite automatically.
# Staging/production: set a real postgres:// or postgresql:// DATABASE_URL
# (Railway) and the config switches to @payloadcms/db-postgres instead, per
# the JOS-20 architecture decision (docs/decisions/phase-1-architecture-and-
# blockers.md in use-me-with-style-platform).
DATABASE_URL=file:./dev.db

PAYLOAD_SECRET=change-me-to-a-long-random-string

# Comma-separated list of origins allowed to call this API (the SPA's dev/
# staging/production URLs).
CORS_ORIGINS=http://localhost:5173,https://use-me-with-style-platform.vercel.app

# Production media storage (Products' photography). Leave S3_BUCKET unset in
# local dev -- media then stays on local disk, no cloud account needed to
# develop. Works with real AWS S3 or any S3-compatible provider (Cloudflare
# R2, Backblaze B2, DigitalOcean Spaces) via @payloadcms/storage-s3.
# Owner: Jay-P (whoever sets up the bucket + IAM/access keys).
#   - S3_BUCKET: bucket name.
#   - S3_REGION: AWS region (e.g. eu-west-1), or "auto" for R2.
#   - S3_ACCESS_KEY_ID / S3_SECRET_ACCESS_KEY: IAM credentials scoped to that
#     bucket only (avoid using root/account-wide keys).
#   - S3_ENDPOINT: only needed for S3-COMPATIBLE providers (R2/B2/Spaces) --
#     leave unset for real AWS S3.
S3_BUCKET=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ENDPOINT=

# WhatsApp/Instagram messaging automation foundation (JOS-58, Phase 1).
# Leave unset in dev -- messages are still logged to the `messages`
# collection and classified, but sends log to the console instead of
# calling the Graph API.
#
# Owners/setup (per JOS-58 acceptance criteria -- fill in once available):
#   - WHATSAPP_ACCESS_TOKEN / WHATSAPP_PHONE_NUMBER_ID: WhatsApp Business
#     Cloud API, from the Meta App used for the client's WhatsApp Business
#     number. Owner: Jay-P / client's WhatsApp Business admin.
#   - INSTAGRAM_ACCESS_TOKEN / INSTAGRAM_PAGE_ID: Instagram messaging via the
#     Facebook Page connected to the client's Instagram Business account.
#     Owner: Jay-P / client's Meta Business Suite admin.
#   - META_WEBHOOK_VERIFY_TOKEN: any string you choose, entered in the Meta
#     App's webhook config to verify /api/messaging-webhook (GET handshake).
#     Owner: whoever sets up the Meta App (dev team).
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_PAGE_ID=
META_WEBHOOK_VERIFY_TOKEN=

# Real Stripe + PayPal payment processing (JOS-61), Portugal/EUR orders only
# -- Angola stays on SWEG/AppyPay (JOS-57) + manual bank transfer, never
# these. Same "log instead of throw, no code change" pattern: while unset,
# the /api/payments/* endpoints return a clear 501 instead of the storefront
# silently pretending to take payment.
#
#   - STRIPE_SECRET_KEY: from the Stripe Dashboard (Developers > API keys).
#   - STRIPE_WEBHOOK_SECRET: from the Dashboard's webhook endpoint config
#     (Developers > Webhooks > add endpoint ->
#     <this service>/api/payments/stripe/webhook, event:
#     checkout.session.completed). Verifies the webhook is really from
#     Stripe.
#   - PAYPAL_CLIENT_ID / PAYPAL_CLIENT_SECRET: from the PayPal Developer
#     Dashboard (a REST API app). PAYPAL_CLIENT_ID is also needed by the
#     frontend (as VITE_PAYPAL_CLIENT_ID) to load the PayPal JS SDK button --
#     it's a public identifier, safe to expose client-side; the secret never
#     is.
#   - PAYPAL_MODE: "sandbox" (default, safe for testing with fake PayPal
#     accounts) or "live".
#   - PUBLIC_SITE_URL: the storefront's real URL, used to build Stripe's
#     success/cancel redirect links (e.g. https://use-me-with-style-platform
#     .vercel.app). Falls back to localhost:5173 if unset.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MODE=sandbox
PUBLIC_SITE_URL=http://localhost:5173

# AppyPay (Angola / Multicaixa Express)
#
# The hosted widget's API key/client ID/legal merchant name are public values
# and live in the storefront VITE_ environment. These two values protect the
# server webhook with HTTP Basic Auth, one of the authorization methods
# supported by AppyPay. Configure the same URL and credentials in the
# AppyPay merchant portal after activation:
#   https://<cms-host>/api/payments/appypay/webhook
APPY_PAY_WEBHOOK_USERNAME=
APPY_PAY_WEBHOOK_PASSWORD=

# Server-to-server verification. The CMS exchanges these credentials for a
# one-hour token, then retrieves every webhook charge from AppyPay before an
# AO order can become paid. Never expose the client secret to the storefront.
APPY_PAY_CLIENT_ID=
APPY_PAY_CLIENT_SECRET=
APPY_PAY_OAUTH_RESOURCE=2aed7612-de64-46b5-9e59-1f48f8902d14
APPY_PAY_OAUTH_TOKEN_URL=https://login.microsoftonline.com/appypaydev.onmicrosoft.com/oauth2/token
APPY_PAY_API_BASE_URL=https://gwy-api-tst.appypay.co.ao/v2.0
APPY_PAY_FISCAL_SERIES_ID=

# Order-confirmation email via Resend (JOS-61 follow-up). Same "log instead
# of throw" pattern as the messaging/payment env vars above: while
# RESEND_API_KEY is unset, no email adapter is configured at all and
# lib/email.ts logs to the console instead of sending -- an order write
# never fails because email isn't set up yet.
#
#   - RESEND_API_KEY: from the Resend dashboard (resend.com/api-keys).
#   - RESEND_FROM_EMAIL: the "from" address. Must be on a domain verified in
#     Resend (Domains tab) -- Resend will reject sends from an unverified
#     domain. Defaults to orders@usemewithstyle.com.
#   - RESEND_FROM_NAME: display name on the "from" line. Defaults to
#     "Use Me With Style".
# Owner: Jay-P (whoever creates the Resend account + verifies the domain).
RESEND_API_KEY=
RESEND_FROM_EMAIL=orders@usemewithstyle.com
RESEND_FROM_NAME=Use Me With Style

# Meta Pixel / Conversions API. The access token is secret and belongs only
# in the CMS/Railway environment. META_TEST_EVENT_CODE is temporary while
# validating Events Manager and should be removed before launch.
META_PIXEL_ID=2812919002423451
META_ACCESS_TOKEN=
META_TEST_EVENT_CODE=

# Phase 1 invoicing is internal and configured in Payload Admin under
# Settings -> Internal Invoicing. No external fiscal-provider credentials are
# required. The generated PDFs are explicitly labelled non-fiscal and are
# intended for the client's accountant. Certified provider credentials will
# be introduced through an adapter in a later phase.
