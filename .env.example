# Local dev (no Postgres/Docker required): a file:./... URL (libSQL/SQLite)
# makes the config below use @payloadcms/db-sqlite automatically.
# Staging/production: set a real postgres:// or postgresql:// DATABASE_URL
# (Railway) and the config switches to @payloadcms/db-postgres instead, per
# the JOS-20 architecture decision (docs/decisions/phase-1-architecture-and-
# blockers.md in use-me-with-style-platform).
DATABASE_URL=file:./dev.db

PAYLOAD_SECRET=change-me-to-a-long-random-string

# Comma-separated list of origins allowed to call this API (the SPA's dev/
# staging/production URLs).
CORS_ORIGINS=http://localhost:5173,https://use-me-with-style-platform.vercel.app

# Production media storage (Products' photography). Leave S3_BUCKET unset in
# local dev -- media then stays on local disk, no cloud account needed to
# develop. Works with real AWS S3 or any S3-compatible provider (Cloudflare
# R2, Backblaze B2, DigitalOcean Spaces) via @payloadcms/storage-s3.
# Owner: Jay-P (whoever sets up the bucket + IAM/access keys).
#   - S3_BUCKET: bucket name.
#   - S3_REGION: AWS region (e.g. eu-west-1), or "auto" for R2.
#   - S3_ACCESS_KEY_ID / S3_SECRET_ACCESS_KEY: IAM credentials scoped to that
#     bucket only (avoid using root/account-wide keys).
#   - S3_ENDPOINT: only needed for S3-COMPATIBLE providers (R2/B2/Spaces) --
#     leave unset for real AWS S3.
S3_BUCKET=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ENDPOINT=

# WhatsApp/Instagram messaging automation foundation (JOS-58, Phase 1).
# Leave unset in dev -- messages are still logged to the `messages`
# collection and classified, but sends log to the console instead of
# calling the Graph API.
#
# Owners/setup (per JOS-58 acceptance criteria -- fill in once available):
#   - WHATSAPP_ACCESS_TOKEN / WHATSAPP_PHONE_NUMBER_ID: WhatsApp Business
#     Cloud API, from the Meta App used for the client's WhatsApp Business
#     number. Owner: Jay-P / client's WhatsApp Business admin.
#   - INSTAGRAM_ACCESS_TOKEN / INSTAGRAM_PAGE_ID: Instagram messaging via the
#     Facebook Page connected to the client's Instagram Business account.
#     Owner: Jay-P / client's Meta Business Suite admin.
#   - META_WEBHOOK_VERIFY_TOKEN: any string you choose, entered in the Meta
#     App's webhook config to verify /api/messaging-webhook (GET handshake).
#     Owner: whoever sets up the Meta App (dev team).
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_PAGE_ID=
META_WEBHOOK_VERIFY_TOKEN=
