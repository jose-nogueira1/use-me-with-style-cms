{
  "$schema": "https://schema.railpack.com",
  "steps": {
    "postgres-client": {
      "inputs": [
        {
          "image": "postgres:18-alpine"
        }
      ],
      "commands": [
        {
          "src": "scripts/package-backup-client.sh",
          "dest": "/tmp/package-backup-client.sh"
        },
        "sh /tmp/package-backup-client.sh"
      ]
    }
  },
  "deploy": {
    "aptPackages": [
      "openssl"
    ],
    "inputs": [
      "...",
      {
        "step": "postgres-client",
        "include": [
          "/opt/backup-postgres"
        ]
      }
    ]
  }
}
